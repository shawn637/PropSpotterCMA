# Required. Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for vendor-motivation classification and narrative generation.
# Defaults to claude-sonnet-4-6 if unset. Swap to claude-haiku-4-5-20251001
# for lower cost / faster responses.
CLAUDE_MODEL=claude-sonnet-4-6

# Data source toggle. Anything other than the literal string "false" uses mock
# fixtures, so the app works out of the box with only an Anthropic key.
MOCK_DATA=true

# HTAG Intelligence API credentials. Only read when MOCK_DATA=false.
# Production base URL per the OpenAPI spec is https://api.htagai.com
# (the /v1 is added by the client paths). Development is
# https://api.dev.htagai.com.
HTAG_API_KEY=
HTAG_API_BASE_URL=https://api.htagai.com

# Shared password required to access any page/API route. Leave unset to
# disable the gate (not recommended for any deployment that's reachable from
# the internet). On Vercel production (VERCEL_ENV=production) the middleware
# refuses to serve requests if this is unset, as a safety rail.
APP_PASSWORD=

# Per-IP requests per minute for /api/cma and /api/pdf. Defaults to 20.
# This is a soft safety rail against accidental burst cost (stuck retry
# loops, a shared password being over-used), not a DoS defense.
RATE_LIMIT_PER_MINUTE=20

# Timeout per HTAG fetch in ms. Defaults to 10000. If HTAG is slow,
# raise this but keep it under the /api/cma maxDuration in vercel.json
# (30s) with headroom for the LLM calls.
HTAG_TIMEOUT_MS=10000
