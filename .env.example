# Required. Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for vendor-motivation classification and narrative generation.
# Defaults to claude-sonnet-4-6 if unset. Swap to claude-haiku-4-5-20251001
# for lower cost / faster responses.
CLAUDE_MODEL=claude-sonnet-4-6

# Data source toggle. Anything other than the literal string "false" uses mock
# fixtures, so the app works out of the box with only an Anthropic key.
MOCK_DATA=true

# HTAG Intelligence API credentials. Only read when MOCK_DATA=false.
HTAG_API_KEY=
HTAG_API_BASE_URL=https://api.prod.htagai.com

# Shared password required to access any page/API route. Leave unset to
# disable the gate (not recommended for any deployment that's reachable from
# the internet).
APP_PASSWORD=
